#encoding utf-8
#
# Device_2pin
#
DEF Device_2pin U 0 40 N N 1 F N
F0 "U" 0 100 50 H V C CNN
F1 "Device_2pin" 0 -100 50 H V C CNN
F2 "" 0 0 50 H I C CNN
F3 "" 0 0 50 H I C CNN
DRAW
S -40 60 40 -60 0 1 10 f
X ~ 1 0 150 90 D 50 50 1 1 P
X ~ 2 0 -150 90 U 50 50 1 1 P
ENDDRAW
ENDDEF
